set version 25.4X300-D40.2-EVO
set system host-name bench-srx440
set system login user netconf uid 2003
set system login user netconf class super-user
set system login user netconf authentication ssh-ed25519 "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIREDACTED lab"
set system syslog file interactive-commands interactive-commands any
set system syslog file messages any notice
set system syslog file messages authorization info
set system syslog file traffic-log any any
set system syslog file traffic-log match RT_FLOW
set system services netconf ssh
set system services ssh root-login allow
set system management-instance
set system name-server 192.0.2.2 routing-instance mgmt_junos
set system name-server 192.0.2.3 routing-instance mgmt_junos
set security log mode event
set security pki ca-profile ISRG_Root_X1 ca-identity ISRG_Root_X1
set security pki ca-profile ISRG_Root_X1 pre-load
set security pki ca-profile Lets_Encrypt ca-identity Lets_Encrypt
set security pki ca-profile Lets_Encrypt enrollment url https://acme-v02.api.letsencrypt.org/directory
set security ike proposal ike-aes256gcm dh-group group20
set security ike proposal ike-aes256gcm encryption-algorithm aes-256-gcm
set security ike proposal ike-aes256gcm lifetime-seconds 28800
set security ike policy ike-pol-hub proposals ike-aes256gcm
set security ike gateway gw-hub ike-policy ike-pol-hub
set security ike gateway gw-hub address 10.66.181.2
set security ike gateway gw-hub dead-peer-detection probe-idle-tunnel
set security ike gateway gw-hub dead-peer-detection interval 10
set security ike gateway gw-hub dead-peer-detection threshold 5
set security ike gateway gw-hub external-interface ge-0/0/0.0
set security ike gateway gw-hub version v2-only
set security ipsec proposal esp-aes256gcm protocol esp
set security ipsec proposal esp-aes256gcm encryption-algorithm aes-256-gcm
set security ipsec proposal esp-aes256gcm lifetime-seconds 3600
set security ipsec policy ipsec-pol perfect-forward-secrecy keys group20
set security ipsec policy ipsec-pol proposals esp-aes256gcm
set security ipsec vpn vpn-hub bind-interface st0.1
set security ipsec vpn vpn-hub ike gateway gw-hub
set security ipsec vpn vpn-hub ike ipsec-policy ipsec-pol
set security ipsec vpn vpn-hub establish-tunnels immediately
set security address-book global address hq-servers 10.66.161.0/24
set security address-book global address hq-dmz 10.66.162.0/24
set security address-book global address br1-users 10.66.151.0/24
set security address-book global address br1-iot 10.66.152.0/24
set security address-book global address br2-users 10.66.171.0/24
set security address-book global address-set lab-hosts address hq-servers
set security address-book global address-set lab-hosts address hq-dmz
set security address-book global address-set lab-hosts address br1-users
set security address-book global address-set lab-hosts address br2-users
set security flow tcp-mss ipsec-vpn mss 1350
set security screen ids-option untrust-screen ip source-route-option
set security screen ids-option untrust-screen ip tear-drop
set security screen ids-option untrust-screen tcp syn-flood alarm-threshold 1024
set security screen ids-option untrust-screen tcp syn-flood attack-threshold 200
set security screen ids-option untrust-screen tcp syn-flood source-threshold 1024
set security screen ids-option untrust-screen tcp syn-flood destination-threshold 2048
set security screen ids-option untrust-screen tcp syn-flood timeout 20
set security screen ids-option untrust-screen tcp land
set security nat source rule-set trust-to-untrust from zone trust
set security nat source rule-set trust-to-untrust to zone untrust
set security nat source rule-set trust-to-untrust rule snat match source-address 0.0.0.0/0
set security nat source rule-set trust-to-untrust rule snat then source-nat interface
set security policies from-zone trust to-zone vpn policy permit-lab match source-address lab-hosts
set security policies from-zone trust to-zone vpn policy permit-lab match destination-address lab-hosts
set security policies from-zone trust to-zone vpn policy permit-lab match application lab-apps
set security policies from-zone trust to-zone vpn policy permit-lab then permit
set security policies from-zone trust to-zone vpn policy permit-lab then log session-close
set security policies from-zone trust to-zone vpn policy deny-all match source-address any
set security policies from-zone trust to-zone vpn policy deny-all match destination-address any
set security policies from-zone trust to-zone vpn policy deny-all match application any
set security policies from-zone trust to-zone vpn policy deny-all then deny
set security policies from-zone trust to-zone vpn policy deny-all then log session-init
