{
  "mcpServers": {
    "junos": {
      "command": "/path/to/rust-junosmcp",
      "args": [
        "-f", "/home/you/.config/rust-junosmcp/devices.json",
        "--known-hosts-file", "/home/you/.config/rust-junosmcp/known_hosts",
        "--device-lease-dir", "/home/you/.local/state/rust-junosmcp/device-leases",
        "--state-file", "/home/you/.local/state/rust-junosmcp/changeset-state.json",
        "--staging-dir", "/home/you/.local/state/rust-junosmcp/staging",
        "--support-bundle-staging-dir", "/home/you/.local/state/rust-junosmcp/srx-staging"
      ]
    }
  }
}
